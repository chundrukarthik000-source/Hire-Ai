# Port and Host settings
PORT=8000
HOST=0.0.0.0

# Mock mode: set to false to connect to Firebase and Gemini
# If this is true, Firestore, Auth, Storage, and Gemini API are simulated locally
MOCK_MODE=true

# Gemini API Key (Required for live mode)
# Generate one from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin configuration (Required for live mode)
# Path to your Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=C:/path/to/your/firebase-service-account.json
# Your Firebase Storage Bucket URL (e.g. your-project-id.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# Your Firebase Database URL
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
